n    align-self: flex-end;\n  }\n}\n\n// No info icon toast styling - keep transparent so sp-toast background shows through\n.noInfoIconToast {\n  background: transparent !important;\n  flex-direction: row !important;\n  flex-wrap: wrap !important;\n  justify-content: flex-start;\n  gap: var(--spectrum-global-dimension-size-200);\n\n  .toastButtonContainer {\n    align-self: flex-end;\n    border-radius: 16px;\n    border: 2px solid\n      var(--Palette-transparent-white-300, rgba(255, 255, 255, 0.17));\n    background: var(--Palette-transparent-white-25, rgba(255, 255, 255, 0));\n  }\n}\n\n// Negative no icon toast styling - keep transparent so sp-toast background shows through\n.noNegativeIconToast {\n  background: transparent !important;\n  flex-direction: row !important;\n  flex-wrap: wrap !important;\n  justify-content: flex-start;\n  gap: var(--spectrum-global-dimension-size-200);\n\n  // Since the icon is loaded as an <img> tag, CSS color can't apply directly. Instead, brightness(0) invert(1) converts any color to white\n  img {\n    filter: brightness(0) invert(1);\n    opacity: 0.85;\n  }\n\n  .toastButtonContainer {\n    align-self: flex-end;\n    border-radius: 16px;\n    border: 2px solid\n      var(--Palette-transparent-white-300, rgba(255, 255, 255, 0.17));\n    background: var(--Palette-transparent-white-25, rgba(255, 255, 255, 0));\n  }\n}\n\n.toastCommercializationMobile {\n  min-inline-size: auto;\n  --mod-toast-max-inline-size: 80vw;\n}\n"],sourceRoot:""}]),o.locals={toastCommercialization:"mb4jeXYFtfkJtUwV",toastButtonContainer:"F0vpIFz8zAVS8ZZ7",noInfoIconToast:"wa5fZKN8U00YwwT6",noNegativeIconToast:"I7HK5piy6pUHnhNg",toastCommercializationMobile:"I2MBDXyigEIRlnQL"};let s=o},157881:function(e,t,a){var r={"./zz-ZZ.json":["613254","30236"],"./hu-HU.json":["443232","57613"],"./fr-FR.json":["76406","80367"],"./nl-NL.json":["27118","16555"],"./th-TH.json":["123346","71323"],"./virtual-presenter/fil-PH.json":["369734","72603"],"./virtual-presenter/nb-