=======\n\nconst IMG_W : u32 = ".concat(256,"u;\nconst IMG_H : u32 = ").concat(256,"u;\nconst TAU   : f32 = 6.28318530717958647692;\nconst PI    : f32 = 3.14159265358979323846;\n\n// -----------------------------------------------------------------------------\n// Small numeric helpers\n// -----------------------------------------------------------------------------\n\n// GLSL-style floating point modulo (WGSL '%' exists but we want an explicit,\n// float-only formulation to keep the \"prefer floating point\" contract).\nfn modf32(x : f32, y : f32) -> f32 {\n    return x - y * floor(x / y);\n}\n\n// Deterministic scalar hash in [0,1).\nfn hash21(p : vec2<f32>) -> f32 {\n    let h = dot(p, vec2<f32>(127.1, 311.7));\n    return fract(sin(h) * 43758.5453123);\n}\n\n// Deterministic vec2 gradient hash in [-1,1].\nfn hash22(p : vec2<f32>) -> vec2<f32> {\n    let a = dot(p, vec2<f32>(127.1, 311.7));\n    let b = dot(p, vec2<f32>(269.5, 183.3));\n    return fract(sin(vec2<f32>(a, b)) * 43758.5453123) * 2.0 - 1.0;\n}\n\n// Deterministic vec3 hash in [0,1).\nfn hash33(p : vec3<f32>) -> vec3<f32> {\n    let a = dot(p, vec3<f32>(127.1, 311.7, 74.7));\n    let b = dot(p, vec3<f32>(269.5, 183.3, 246.1));\n    let c = dot(p, vec3<f32>(113.5, 271.9, 124.6));\n    return fract(sin(vec3<f32>(a, b, c)) * 43758.5453123);\n}\n\n// -----------------------------------------------------------------------------\n// Gradient noise + fBm + domain warp (used by tiles 4, 5 and 8)\n// -----------------------------------------------------------------------------\n\nfn gradientNoise(p : vec2<f32>) -> f32 {\n    let i = floor(p);\n    let f = fract(p);\n    // Quintic-ish interpolation via smoothstep-shaped weights.\n    let u = f * f * (3.0 - 2.0 * f);\n    let a = dot(hash22(i + vec2<f32>(0.0, 0.0)), f - vec2<f32>(0.0, 0.0));\n    let b = dot(hash22(i + vec2<f32>(1.0, 0.0)), f - vec2<f32>(1.0, 0.0));\n    let c = dot(hash22(i + vec2<f32>(0.0, 1.0)), f - vec2<f32>(0.0, 1.0));\n    let d = dot(hash22(i + vec2<f32>(1.0, 1.0)), f - vec2<f32>(1.0, 1.0));\n    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\n\n// 8-octave fractal Brownian motion. The domain is nudged every octave using the\n// running sum so the dependency chain never resets.\nfn fbm(p0 : vec2<f32>) -> f32 {\n    var p    = p0;\n    var amp  = 0.5;\n    var freq = 1.0;\n    var sum  = 0.0;\n    for (var o = 0; o < 8; o = o + 1) {\n        sum  = sum + amp * gradientNoise(p * freq);\n        freq = freq * 2.01;                 // slightly irrational lacunarity\n        amp  = amp * 0.5;\n        // Domain interpolation: rotate/translate the sample point by the\n        // accumulated signal so later octaves depend on earlier ones.\n        let s = sin(sum);\n        let c = cos(sum);\n        p = mat2x2<f32>(c, -s, s, c) * p + vec2<f32>(s, c) * 0.15;\n    }\n    return sum;\n}\n\n// -----------------------------------------------------------------------------\n// Voronoi helpers (tile 6)\n// -----------------------------------------------------------------------------\n\n// Signed-distance field of a torus (tile 7)\nfn sdTorus(p : vec3<f32>, t : vec2<f32>) -> f32 {\n    let q = vec2<f32>(length(p.xz) - t.x, p.y);\n    return length(q) - t.y;\n}\nfn sdSphere(p : vec3<f32>, r : f32) -> f32 {\n    return length(p) - r;\n}\nfn sdPlane(p : vec3<f32>) -> f32 {\n    return p.y + 1.0;\n}\nfn opU(a : f32, b : f32) -> f32 {\n    return min(a, b);\n}\n\nfn sceneSDF(p : vec3<f32>) -> f32 {\n    let s = sdSphere(p - vec3<f32>(-1.15, 0.0, 0.0), 0.85);\n    // Rotate the torus by a fixed angle (deterministic; no time input).\n    var pt = p - vec3<f32>(1.2, 0.2, 0.0);\n    let a  = 0.7;\n    let ca = cos(a);\n    let sa = sin(a);\n    pt = vec3<f32>(pt.x, ca * pt.y - sa * pt.z, sa * pt.y + ca * pt.z);\n    let t  = sdTorus(pt, vec2<f32>(0.7, 0.28));\n    let pl = sdPlane(p);\n    return opU(opU(s, t), pl);\n}\n\nfn calcNormal(p : vec3<f32>) -> vec3<f32> {\n    let e = vec2<f32>(0.0012, 0.0);\n    let n = vec3<f32>(\n        sceneSDF(p + e.xyy) - sceneSDF(p - e.xyy),\n        sceneSDF(p + e.yxy) - sceneSDF(p - e.yxy),\n        sceneSDF(p + e.yyx) - sceneSDF(p - e.yyx)\n    );\n    return normalize(n);\n}\n\nfn softShadow(ro : vec3<f32>, rd : vec3<f32>) -> f32 {\n    var res = 1.0;\n    var t   = 0.02;\n    for (var i = 0; i < 48; i = i + 1) {\n        let h = sceneSDF(ro + rd * t);\n        res = min(res, 8.0 * h / t);\n        t   = t + clamp(h, 0.012, 0.2);\n        if (h < 0.001 || t > 20.0) { break; }\n    }\n    return clamp(res, 0.0, 1.0);\n}\n\nfn ambientOcclusion(p : vec3<f32>, n : vec3<f32>) -> f32 {\n    var occ = 0.0;\n    var sca = 1.0;\n    for (var i = 0; i < 5; i = i + 1) {\n        let hr = 0.01 + 0.12 * f32(i) / 4.0;\n        let d  = sceneSDF(p + n * hr);\n        occ = occ + (hr - d) * sca;\n        sca = sca * 0.95;\n    }\n    return clamp(1.0 - 3.0 * occ, 0.0, 1.0);\n}\n\n// -----------------------------------------------------------------------------\n// ACES tone map (tile 8)\n// -----------------------------------------------------------------------------\nfn acesFilm(x : vec3<f32>) -> vec3<f32> {\n    let a = 2.51;\n    let b = 0.03;\n    let c = 2.43;\n    let d = 0.59;\n    let e = 0.14;\n    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3<f32>(0.0), vec3<f32>(1.0));\n}\n\n// -----------------------------------------------------------------------------\n// Matrix / quaternion helpers (tile 9)\n// -----------------------------------------------------------------------------\nfn rotX(a : f32) -> mat3x3<f32> {\n    let c = cos(a);\n    let s = sin(a);\n    return mat3x3<f32>(1.0, 0.0, 0.0,   0.0, c, s,   0.0, -s, c);\n}\nfn rotY(a : f32) -> mat3x3<f32> {\n    let c = cos(a);\n    let s = sin(a);\n    return mat3x3<f32>(c, 0.0, -s,   0.0, 1.0, 0.0,   s, 0.0, c);\n}\nfn rotZ(a : f32) -> mat3x3<f32> {\n    let c = cos(a);\n    let s = sin(a);\n    return mat3x3<f32>(c, s, 0.0,   -s, c, 0.0,   0.0, 0.0, 1.0);\n}\n\n// Explicit 3x3 inverse (WGSL has determinant() but no inverse() builtin).\n// Element mRC == row R, column C. WGSL matrices are column-major: m[col][row].\nfn inverse3(m : mat3x3<f32>) -> mat3x3<f32> {\n    let m00 = m[0][0]; let m01 = m[1][0]; let m02 = m[2][0];\n    let m10 = m[0][1]; let m11 = m[1][1]; let m12 = m[2][1];\n    let m20 = m[0][2]; let m21 = m[1][2]; let m22 = m[2][2];\n\n    let c00 = m11 * m22 - m12 * m21;\n    let c01 = m12 * m20 - m10 * m22;\n    let c02 = m10 * m21 - m11 * m20;\n    let det = m00 * c00 + m01 * c01 + m02 * c02;\n    let invDet = 1.0 / det;\n\n    let r00 = c00 * invDet;\n    let r01 = (m02 * m21 - m01 * m22) * invDet;\n    let r02 = (m01 * m12 - m02 * m11) * invDet;\n    let r10 = c01 * invDet;\n    let r11 = (m00 * m22 - m02 * m20) * invDet;\n    let r12 = (m02 * m10 - m00 * m12) * invDet;\n    let r20 = c02 * invDet;\n    let r21 = (m01 * m20 - m00 * m21) * invDet;\n    let r22 = (m00 * m11 - m01 * m10) * invDet;\n\n    // Reassemble column-major: column c = (r0c, r1c, r2c).\n    return mat3x3<f32>(\n        r00, r10, r20,\n        r01, r11, r21,\n        r02, r12, r22\n    );\n}\n\nfn rotateByQuat(v : vec3<f32>, q : vec4<f32>) -> vec3<f32> {\n    let u = q.xyz;\n    let s = q.w;\n    return 2.0 * dot(u, v) * u + (s * s - dot(u, u)) * v + 2.0 * s * cross(u, v);\n}\n\n// =============================================================================\n// Tile algorithms. Each takes a tile-local uv in [0,1] and returns unclamped\n// HDR vec4<f32>. Colour is deliberately built from long transcendental chains.\n// =============================================================================\n\n// --- Tile 1: Mandelbrot, deep iterations, smooth colouring --------------------\nfn mandelbrot(uv : vec2<f32>) -> vec4<f32> {\n    let center = vec2<f32>(-0.743643887037158704, 0.131825904205311970);\n    let zoom   = 0.0016;\n    let c = center + (uv - 0.5) * zoom;\n    var z = vec2<f32>(0.0, 0.0);\n    var i = 0.0;\n    let maxIter = 512.0;\n    var trap = 1.0e20;\n    loop {\n        if (i >= maxIter) { break; }\n        z = vec2<f32>(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;\n        let m2 = dot(z, z);\n        trap = min(trap, m2);\n        if (m2 > 65536.0) { break; }\n        i = i + 1.0;\n    }\n    let m2 = dot(z, z);\n    // Smooth (fractional) iteration count.\n    let nu = log2(max(log2(max(m2, 2.0)) * 0.5, 1.0e-6));\n    let sm = i + 1.0 - nu;\n    let t  = sm / maxIter;\n    let glow = exp(-trap * 3.5);\n    let col = 0.5 + 0.5 * cos(TAU * (vec3<f32>(0.30, 0.20, 0.12) + t * 6.0) + vec3<f32>(0.0, 0.6, 1.0));\n    return vec4<f32>(col * (0.6 + 2.4 * glow), 1.0);\n}\n\n// --- Tile 2: Julia set, different constant + iteration count ------------------\nfn julia(uv : vec2<f32>) -> vec4<f32> {\n    let cc = vec2<f32>(-0.8, 0.156);\n    var z  = (uv - 0.5) * 3.0;\n    var i  = 0.0;\n    let maxIter = 384.0;\n    loop {\n        if (i >= maxIter) { break; }\n        z = vec2<f32>(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + cc;\n        if (dot(z, z) > 65536.0) { break; }\n        i = i + 1.0;\n    }\n    let m2  = dot(z, z);\n    let nu  = log2(max(log2(max(m2, 2.0)) * 0.5, 1.0e-6));\n    let sm  = i + 1.0 - nu;\n    let t   = sm / maxIter;\n    let ang = atan2(z.y, z.x);\n    let col = 0.5 + 0.5 * sin(vec3<f32>(1.0, 2.5, 4.0) * t * 9.0 + ang + vec3<f32>(0.0, 2.0, 4.0));\n    return vec4<f32>(pow(col, vec3<f32>(0.85)), 1.0);\n}\n\n// --- Tile 3: Logistic map, 3000 iterations of x = r*x*(1-x), r = 3.99997 ------\nfn logistic(uv : vec2<f32>) -> vec4<f32> {\n    let r = 3.99997;\n    var x = 0.05 + 0.90 * hash21(uv * 51.7 + 3.3);\n    var acc  = 0.0;\n    var lyap = 0.0;               // running Lyapunov-style sum (uses log)\n    for (var i = 0; i < 3000; i = i + 1) {\n        x    = r * x * (1.0 - x);           // never reset, never clamp\n        acc  = acc + x;\n        lyap = lyap + log(abs(r * (1.0 - 2.0 * x)) + 1.0e-9);\n    }\n    let mean = acc / 3000.0;\n    let ly   = lyap / 3000.0;\n    let c    = vec3<f32>(x, mean, fract(modf32(x * mean * 17.0 + ly, 1.0)));\n    let col  = 0.5 + 0.5 * cos(TAU * c + vec3<f32>(0.0, 2.0, 4.0));\n    return vec4<f32>(col * (0.4 + 0.9 * x), 1.0);\n}\n\n// --- Tile 4: Fractal Brownian Motion, 8 octaves, gradient noise ---------------\nfn tileFbm(uv : vec2<f32>) -> vec4<f32> {\n    let p  = uv * 6.0;\n    let n  = fbm(p);\n    let n2 = fbm(p + vec2<f32>(5.2, 1.3) + n);\n    let n3 = fbm(p * 1.7 - vec2<f32>(n2, n));\n    let col = 0.5 + 0.5 * cos(vec3<f32>(0.0, 1.0, 2.0) + n * 3.0 + n2 * 2.0 + n3 + vec3<f32>(0.0, 2.0, 4.0));\n    return vec4<f32>(col * smoothstep(-0.6, 0.9, n + n2), 1.0);\n}\n\n// --- Tile 5: Domain-warped noise: noise -> warp -> noise -> warp -> noise -----\nfn domainWarp(uv : vec2<f32>) -> vec4<f32> {\n    let p = uv * 4.0;\n    let q = vec2<f32>(fbm(p + vec2<f32>(0.0, 0.0)),\n                      fbm(p + vec2<f32>(5.2, 1.3)));\n    let warp1 = p + 4.0 * q + vec2<f32>(sin(p.x * 3.0), cos(p.y * 3.0));\n    let r = vec2<f32>(fbm(warp1 + vec2<f32>(1.7, 9.2)),\n                      fbm(warp1 + vec2<f32>(8.3, 2.8)));\n    let warp2 = warp1 + 4.0 * r + vec2<f32>(cos(r.y * 5.0), sin(r.x * 5.0));\n    let f = fbm(warp2);\n    let shade = length(q) + 0.5 * length(r);\n    let col = 0.5 + 0.5 * cos(vec3<f32>(2.0, 1.0, 0.5) * f * 4.0\n                              + shade * vec3<f32>(1.0, 2.0, 3.0)\n                              + vec3<f32>(0.0, 2.0, 4.0));\n    return vec4<f32>(col * (0.55 + 0.7 * f), 1.0);\n}\n\n// --- Tile 6: Voronoi distance field, F1/F2 neighbours, cell colouring ---------\nfn voronoi(uv : vec2<f32>) -> vec4<f32> {\n    let p  = uv * 8.0;\n    let ip = floor(p);\n    let fp = fract(p);\n    var d1 = 1.0e9;\n    var d2 = 1.0e9;\n    var cell = vec2<f32>(0.0);\n    for (var y = -1; y <= 1; y = y + 1) {\n        for (var x = -1; x <= 1; x = x + 1) {\n            let g = vec2<f32>(f32(x), f32(y));\n            let o = hash22(ip + g) * 0.5 + 0.5;   // feature point in [0,1]\n            let rr = g + o - fp;\n            let d  = dot(rr, rr);\n            if (d < d1) {\n                d2 = d1; d1 = d; cell = ip + g;\n            } else if (d < d2) {\n                d2 = d;\n            }\n        }\n    }\n    let edge = sqrt(d2) - sqrt(d1);            // F2 - F1 border field\n    let cc   = hash21(cell * 1.37 + 4.1);\n    let col  = 0.5 + 0.5 * cos(vec3<f32>(1.0, 2.0, 3.0) * cc * TAU + vec3<f32>(0.0, 2.0, 4.0));\n    let border = smoothstep(0.0, 0.14, edge);\n    return vec4<f32>(col * border + vec3<f32>(exp(-7.0 * d1)) * 0.6, 1.0);\n}\n\n// --- Tile 7: SDF ray marcher, 200 steps, soft shadow + AO ---------------------\nfn raymarch(uv : vec2<f32>) -> vec4<f32> {\n    let p  = (uv - 0.5) * 2.0;\n    let ro = vec3<f32>(0.0, 0.85, 4.0);\n    let ta = vec3<f32>(0.0, 0.0, 0.0);\n    let ww = normalize(ta - ro);\n    let uu = normalize(cross(ww, vec3<f32>(0.0, 1.0, 0.0)));\n    let vv = cross(uu, ww);\n    let rd = normalize(p.x * uu + p.y * vv + 1.6 * ww);\n\n    var t   = 0.0;\n    var hit = 0.0;\n    for (var i = 0; i < 200; i = i + 1) {      // 200 march steps\n        let pos = ro + rd * t;\n        let d   = sceneSDF(pos);\n        if (d < 0.0008) { hit = 1.0; break; }\n        t = t + d;\n        if (t > 30.0) { break; }\n    }\n\n    var col = vec3<f32>(0.5, 0.7, 1.0) * (0.55 + 0.45 * rd.y);   // sky\n    if (hit > 0.5) {\n        let pos = ro + rd * t;\n        let n   = calcNormal(pos);\n        let lig = normalize(vec3<f32>(0.8, 0.9, 0.4));\n        let dif = clamp(dot(n, lig), 0.0, 1.0);\n        let sh  = softShadow(pos + n * 0.002, lig);\n        let occ = ambientOcclusion(pos, n);\n        let refl = reflect(-lig, n);\n        let spe = pow(clamp(dot(refl, -rd), 0.0, 1.0), 32.0);\n        let amb = 0.3 * occ;\n        col = vec3<f32>(0.9, 0.7, 0.5) * (dif * sh)\n            + vec3<f32>(1.0) * spe * sh\n            + amb * vec3<f32>(0.4, 0.5, 0.7);\n    }\n    return vec4<f32>(col, 1.0);\n}\n\n// --- Tile 8: HDR tone mapping (ACES, exposure, contrast, sat, gamma, bloom) ---\nfn toneMap(uv : vec2<f32>) -> vec4<f32> {\n    let p = uv * 4.0;\n    // Build a synthetic HDR field.\n    var hdr = vec3<f32>(0.4 + 0.6 * fbm(p),\n                        0.3 + 0.5 * fbm(p + 3.1),\n                        0.2 + 0.8 * fbm(p + 7.7));\n    // Bright bloom source near the tile centre.\n    let d     = length(uv - vec2<f32>(0.5));\n    let spark = exp(-d * d * 22.0) * 9.0;\n    hdr = (hdr + vec3<f32>(1.0, 0.8, 0.6) * spark) * 6.0;   // push into HDR range\n\n    let exposure = 1.2;\n    var c = hdr * exposure;\n\n    // Bloom approximation: low-frequency spread added back.\n    let bloom = vec3<f32>(fbm(p * 0.5), fbm(p * 0.5 + 2.0), fbm(p * 0.5 + 4.0)) * spark * 0.5;\n    c = c + bloom;\n\n    c = acesFilm(c);                                  // ACES filmic curve\n\n    let contrast = 1.15;\n    c = (c - 0.5) * contrast + 0.5;                   // contrast\n\n    let lum = dot(c, vec3<f32>(0.2126, 0.7152, 0.0722));\n    let saturation = 1.25;\n    c = mix(vec3<f32>(lum), c, saturation);           // saturation\n\n    c = pow(max(c, vec3<f32>(0.0)), vec3<f32>(1.0 / 2.2));  // gamma\n    return vec4<f32>(c, 1.0);\n}\n\n// --- Tile 9: Matrix perturbation (mult, inverse, determinant, quaternion) -----\nfn matrixChaos(uv : vec2<f32>) -> vec4<f32> {\n    let a = uv.x * TAU;\n    let b = uv.y * TAU;\n    var m = rotX(a) * rotY(b) * rotZ(a * 0.5 + b * 0.3);\n    var v = vec3<f32>(uv.x - 0.5, uv.y - 0.5, 0.25);\n\n    // Long dependency chain of repeated matrix multiplications.\n    for (var i = 0; i < 12; i = i + 1) {\n        let ang = 0.3 + f32(i) * 0.11 + a * 0.05;\n        m = m * rotY(ang) * rotZ(ang * 0.7);\n        v = m * normalize(v + vec3<f32>(0.001, 0.0, 0.0));\n        v = v + 0.05 * vec3<f32>(sin(v.y), cos(v.z), sin(v.x));\n    }\n\n    let det = determinant(m);\n    let inv = inverse3(m);\n    v = inv * v;\n\n    // Quaternion rotation.\n    let axis = normalize(vec3<f32>(0.3, 0.8, 0.5));\n    let halfAng = (a + b) * 0.5;\n    let q    = 